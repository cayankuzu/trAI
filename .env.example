# Supabase değişkenleri olmadan bazı yerel ekranlar development/test verisi kullanabilir.
# Sanal prova için demo sonuç yolu yoktur; Supabase ve fal.ai sunucu değişkenleri zorunludur.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Yalnız `next dev` ile yerel testte kota/batch/rate sınırlarını kapatır; Vercel/production'da çalışmaz.
TRY_ON_UNLIMITED_TEST_MODE=false

# Supabase > Project Settings > API / Connect
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase > Project Settings > API Keys > Secret keys (sb_secret_...). Yalnızca sunucuda kullanılır.
SUPABASE_SECRET_KEY=

# fal.ai > Dashboard > Keys. Bu değer yalnızca sunucuda okunur; NEXT_PUBLIC_ öneki eklemeyin.
FAL_KEY=
